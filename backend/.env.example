
# El .env NO se sube a Git; el .env.example SÍ 
# mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL="mysql://root:TU_PASSWORD@localhost:3306/buysellcycle"
PORT=3000
FRONTEND_URL="http://localhost:5173"
# Firebase (proyecto "demo-" = solo emuladores, no necesita cuenta de Google)
FIREBASE_PROJECT_ID="demo-buysellcycle"
FIREBASE_STORAGE_BUCKET="demo-buysellcycle.appspot.com"
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"
# Email. Si SMTP_HOST queda vacío se usa una cuenta de prueba de Ethereal.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="BuySellCycle <ventas@buysellcycle.com>"